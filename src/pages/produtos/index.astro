---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import { Database } from '../../lib/db';
import { formatPrice } from '../../lib/utils';
import type { Product, Category } from '../../types';

// Get database from Astro.locals
const db = new Database(Astro.locals.runtime.env.DB);

// Get query parameters
const url = new URL(Astro.request.url);
const categorySlug = url.searchParams.get('categoria');
const searchQuery = url.searchParams.get('q');

// Fetch categories
const categories = await db.getCategories();
const activeCategories = categories.filter(cat => cat.active === 1);

// Fetch products based on filters
let products: Product[] = [];
let currentCategory: Category | undefined;

if (searchQuery) {
  products = await db.searchProducts(searchQuery);
} else if (categorySlug) {
  currentCategory = await db.getCategoryBySlug(categorySlug);
  if (currentCategory) {
    products = await db.getProducts(currentCategory.id);
  }
} else {
  products = await db.getProducts();
}

// Filter only active products
const activeProducts = products.filter(p => p.active === 1);

// Page title and description
const pageTitle = currentCategory
  ? `${currentCategory.name} - BM Peças Diesel`
  : searchQuery
  ? `Resultados para "${searchQuery}" - BM Peças Diesel`
  : 'Produtos - BM Peças Diesel';

const pageDescription = currentCategory?.description ||
  'Confira nosso catálogo completo de peças para caminhões e implementos rodoviários';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header slot="header" client:load />

  <!-- Breadcrumb -->
  <section class="bg-gray-100 py-4">
    <div class="container mx-auto px-4">
      <nav class="flex items-center space-x-2 text-sm text-gray-600">
        <a href="/" class="hover:text-primary-600">Início</a>
        <span>/</span>
        <a href="/produtos" class="hover:text-primary-600">Produtos</a>
        {currentCategory && (
          <>
            <span>/</span>
            <span class="text-gray-900 font-semibold">{currentCategory.name}</span>
          </>
        )}
      </nav>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar -->
        <aside class="lg:w-64 flex-shrink-0">
          <div class="sticky top-24">
            <!-- Search -->
            <div class="card mb-6">
              <h3 class="font-bold text-lg mb-4">Buscar Produtos</h3>
              <form action="/produtos" method="get">
                <div class="relative">
                  <input
                    type="text"
                    name="q"
                    placeholder="Digite o nome ou código..."
                    value={searchQuery || ''}
                    class="input w-full pl-10"
                  />
                  <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <button type="submit" class="btn btn-primary w-full mt-3">
                  Buscar
                </button>
              </form>
            </div>

            <!-- Categories -->
            <div class="card">
              <h3 class="font-bold text-lg mb-4">Categorias</h3>
              <ul class="space-y-2">
                <li>
                  <a
                    href="/produtos"
                    class={`block py-2 px-3 rounded transition-colors ${
                      !categorySlug && !searchQuery
                        ? 'bg-primary-100 text-primary-700 font-semibold'
                        : 'hover:bg-gray-100'
                    }`}
                  >
                    Todas as Categorias
                  </a>
                </li>
                {activeCategories.map((category) => (
                  <li>
                    <a
                      href={`/produtos?categoria=${category.slug}`}
                      class={`block py-2 px-3 rounded transition-colors ${
                        categorySlug === category.slug
                          ? 'bg-primary-100 text-primary-700 font-semibold'
                          : 'hover:bg-gray-100'
                      }`}
                    >
                      {category.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Contact CTA -->
            <div class="card mt-6 bg-gradient-to-br from-primary-600 to-primary-800 text-white">
              <h3 class="font-bold text-lg mb-2">Precisa de Ajuda?</h3>
              <p class="text-sm text-blue-100 mb-4">
                Nossa equipe está pronta para atendê-lo
              </p>
              <a
                href="https://wa.me/5519971477055"
                class="btn bg-white text-primary-700 hover:bg-gray-100 w-full"
              >
                <svg class="inline-block w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Falar no WhatsApp
              </a>
            </div>
          </div>
        </aside>

        <!-- Products Grid -->
        <main class="flex-1">
          <!-- Header -->
          <div class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
              {currentCategory ? currentCategory.name : searchQuery ? `Resultados para "${searchQuery}"` : 'Todos os Produtos'}
            </h1>
            {currentCategory?.description && (
              <p class="text-gray-600">{currentCategory.description}</p>
            )}
            <p class="text-gray-500 mt-2">
              {activeProducts.length} {activeProducts.length === 1 ? 'produto encontrado' : 'produtos encontrados'}
            </p>
          </div>

          {activeProducts.length === 0 ? (
            <!-- No Results -->
            <div class="text-center py-16">
              <svg class="w-24 h-24 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
              </svg>
              <h2 class="text-2xl font-bold text-gray-700 mb-2">Nenhum produto encontrado</h2>
              <p class="text-gray-500 mb-6">
                {searchQuery
                  ? 'Tente buscar com outros termos ou navegue pelas categorias'
                  : 'Não há produtos disponíveis nesta categoria no momento'}
              </p>
              <div class="flex gap-4 justify-center">
                <a href="/produtos" class="btn btn-primary">
                  Ver Todos os Produtos
                </a>
                <a href="https://wa.me/5519971477055" class="btn bg-green-500 hover:bg-green-600 text-white">
                  Falar com Especialista
                </a>
              </div>
            </div>
          ) : (
            <!-- Products Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="products-grid">
              {activeProducts.map((product) => (
                <div class="product-card card group hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                  <div class="relative overflow-hidden rounded-t-lg bg-gray-100">
                    {product.image_url ? (
                      <img
                        src={product.image_url}
                        alt={product.name}
                        class="w-full h-56 object-cover group-hover:scale-110 transition-transform duration-500"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-56 flex items-center justify-center bg-gradient-to-br from-gray-200 to-gray-300">
                        <svg class="w-20 h-20 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                      </div>
                    )}
                    {product.featured === 1 && (
                      <div class="absolute top-3 right-3 bg-yellow-500 text-white px-2 py-1 rounded-full text-xs font-bold shadow-lg">
                        Destaque
                      </div>
                    )}
                    {product.stock_quantity !== null && product.stock_quantity <= 0 && (
                      <div class="absolute inset-0 bg-black bg-opacity-60 flex items-center justify-center">
                        <span class="bg-red-500 text-white px-4 py-2 rounded-lg font-bold">
                          Indisponível
                        </span>
                      </div>
                    )}
                  </div>
                  <div class="p-5">
                    <h3 class="font-bold text-lg mb-2 text-gray-800 group-hover:text-primary-600 transition-colors line-clamp-2">
                      {product.name}
                    </h3>
                    {product.code && (
                      <p class="text-xs text-gray-500 mb-3">Código: {product.code}</p>
                    )}
                    {product.description && (
                      <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                        {product.description}
                      </p>
                    )}
                    <div class="flex items-center justify-between mb-4">
                      {product.price ? (
                        <p class="text-2xl font-bold text-primary-600">
                          {formatPrice(product.price)}
                        </p>
                      ) : (
                        <p class="text-lg font-semibold text-gray-700">Consulte</p>
                      )}
                      {product.stock_quantity !== null && product.stock_quantity > 0 && (
                        <span class="text-sm text-green-600 font-medium">
                          Em estoque
                        </span>
                      )}
                    </div>
                    <div class="flex gap-2">
                      <a
                        href={`/produtos/${product.slug}`}
                        class="btn btn-primary flex-1 text-center text-sm"
                      >
                        Ver Detalhes
                      </a>
                      <a
                        href={`https://wa.me/5519971477055?text=Olá! Tenho interesse no produto: ${encodeURIComponent(product.name)}`}
                        class="btn bg-green-500 hover:bg-green-600 text-white px-3"
                        title="Consultar via WhatsApp"
                      >
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </main>
      </div>
    </div>
  </section>

  <!-- Animation Script -->
  <script>
    import anime from 'animejs/lib/anime.es.js';

    // Animate product cards on load
    anime({
      targets: '.product-card',
      translateY: [40, 0],
      opacity: [0, 1],
      delay: anime.stagger(80),
      easing: 'easeOutQuad',
      duration: 600,
    });
  </script>

  <Footer slot="footer" client:load />
</BaseLayout>
