---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Database } from '../../../lib/db';

// Get database
const db = new Database(Astro.locals.runtime.env.DB);

// Get all categories
const categories = await db.getCategories();
---

<AdminLayout title="Categorias">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Categorias</h1>
        <p class="text-gray-600">Gerencie as categorias de produtos</p>
      </div>
      <a href="/admin/categorias/nova" class="btn btn-primary">
        + Nova Categoria
      </a>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((category) => (
        <div class="card">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="font-bold text-xl text-gray-900 mb-1">
                {category.name}
              </h3>
              <p class="text-sm text-gray-500">
                Slug: {category.slug}
              </p>
            </div>
            <span class={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
              category.active === 1 ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
            }`}>
              {category.active === 1 ? 'Ativa' : 'Inativa'}
            </span>
          </div>

          {category.description && (
            <p class="text-gray-600 text-sm mb-4 line-clamp-2">
              {category.description}
            </p>
          )}

          <div class="flex gap-2 pt-4 border-t border-gray-200">
            <a
              href={`/produtos?categoria=${category.slug}`}
              target="_blank"
              class="btn bg-gray-200 hover:bg-gray-300 text-gray-700 flex-1 text-sm text-center"
            >
              Ver no Site
            </a>
            <a
              href={`/admin/categorias/editar/${category.id}`}
              class="btn btn-primary flex-1 text-sm text-center"
            >
              Editar
            </a>
          </div>
        </div>
      ))}

      {categories.length === 0 && (
        <div class="col-span-full text-center py-12 card">
          <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
          <p class="text-gray-600 mb-4">Nenhuma categoria cadastrada</p>
          <a href="/admin/categorias/nova" class="btn btn-primary">
            Cadastrar Primeira Categoria
          </a>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
