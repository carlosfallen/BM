---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Database } from '../../../lib/db';
import { formatPrice } from '../../../lib/utils';

// Get database
const db = new Database(Astro.locals.runtime.env.DB);

// Get all products and categories
const products = await db.getProducts();
const categories = await db.getCategories();

// Create category map for quick lookup
const categoryMap = new Map(categories.map(c => [c.id, c]));
---

<AdminLayout title="Produtos">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Produtos</h1>
        <p class="text-gray-600">Gerencie o catálogo de produtos</p>
      </div>
      <a href="/admin/produtos/novo" class="btn btn-primary">
        + Novo Produto
      </a>
    </div>

    <!-- Products Table -->
    <div class="card">
      {products.length === 0 ? (
        <div class="text-center py-12">
          <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
          <p class="text-gray-600 mb-4">Nenhum produto cadastrado</p>
          <a href="/admin/produtos/novo" class="btn btn-primary">
            Cadastrar Primeiro Produto
          </a>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left py-3 px-4 font-semibold text-gray-700">Produto</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-700">Categoria</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-700">Preço</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-700">Estoque</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-700">Status</th>
                <th class="text-right py-3 px-4 font-semibold text-gray-700">Ações</th>
              </tr>
            </thead>
            <tbody>
              {products.map((product) => {
                const category = categoryMap.get(product.category_id);
                return (
                  <tr class="border-b border-gray-100 hover:bg-gray-50">
                    <td class="py-3 px-4">
                      <div class="flex items-center gap-3">
                        {product.image_url ? (
                          <img
                            src={product.image_url}
                            alt={product.name}
                            class="w-12 h-12 object-cover rounded"
                          />
                        ) : (
                          <div class="w-12 h-12 bg-gray-200 rounded flex items-center justify-center">
                            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                            </svg>
                          </div>
                        )}
                        <div>
                          <p class="font-medium text-gray-900">{product.name}</p>
                          {product.code && (
                            <p class="text-xs text-gray-500">Cód: {product.code}</p>
                          )}
                        </div>
                      </div>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600">
                      {category?.name || 'Sem categoria'}
                    </td>
                    <td class="py-3 px-4 text-sm font-medium text-gray-900">
                      {product.price ? formatPrice(product.price) : 'Consulte'}
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600">
                      {product.stock_quantity !== null ? product.stock_quantity : 'N/A'}
                    </td>
                    <td class="py-3 px-4">
                      <div class="flex gap-2">
                        {product.active === 1 ? (
                          <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                            Ativo
                          </span>
                        ) : (
                          <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                            Inativo
                          </span>
                        )}
                        {product.featured === 1 && (
                          <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                            Destaque
                          </span>
                        )}
                      </div>
                    </td>
                    <td class="py-3 px-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <a
                          href={`/produtos/${product.slug}`}
                          target="_blank"
                          class="text-gray-600 hover:text-gray-900 text-sm"
                          title="Ver no site"
                        >
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                          </svg>
                        </a>
                        <a
                          href={`/admin/produtos/editar/${product.id}`}
                          class="text-primary-600 hover:text-primary-700 text-sm font-medium"
                        >
                          Editar
                        </a>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
