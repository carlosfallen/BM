---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
---

<BaseLayout
  title="Finalizar Pedido - BM Peças Diesel"
  description="Finalize seu pedido na BM Peças Diesel. Atendimento rápido via WhatsApp."
>
  <Header slot="header" client:load />

  <!-- Breadcrumb -->
  <section class="bg-gray-100 py-4">
    <div class="container mx-auto px-4">
      <nav class="flex items-center space-x-2 text-sm text-gray-600">
        <a href="/" class="hover:text-primary-600">Início</a>
        <span>/</span>
        <a href="/produtos" class="hover:text-primary-600">Produtos</a>
        <span>/</span>
        <span class="text-gray-900 font-semibold">Checkout</span>
      </nav>
    </div>
  </section>

  <!-- Checkout -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
          Finalizar Pedido
        </h1>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Form -->
          <div class="lg:col-span-2">
            <form id="checkout-form" class="space-y-6">
              <!-- Personal Info -->
              <div class="card">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Dados Pessoais</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="md:col-span-2">
                    <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
                      Nome Completo *
                    </label>
                    <input
                      type="text"
                      id="name"
                      name="name"
                      required
                      class="input w-full"
                      placeholder="Seu nome completo"
                    />
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
                      E-mail *
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="input w-full"
                      placeholder="seu@email.com"
                    />
                  </div>
                  <div>
                    <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">
                      Telefone/WhatsApp *
                    </label>
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      required
                      class="input w-full"
                      placeholder="(19) 97147-7055"
                    />
                  </div>
                </div>
              </div>

              <!-- Address -->
              <div class="card">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Endereço de Entrega</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="md:col-span-2">
                    <label for="address" class="block text-sm font-semibold text-gray-700 mb-2">
                      Endereço *
                    </label>
                    <input
                      type="text"
                      id="address"
                      name="address"
                      required
                      class="input w-full"
                      placeholder="Rua, número"
                    />
                  </div>
                  <div>
                    <label for="city" class="block text-sm font-semibold text-gray-700 mb-2">
                      Cidade *
                    </label>
                    <input
                      type="text"
                      id="city"
                      name="city"
                      required
                      class="input w-full"
                      placeholder="Sua cidade"
                    />
                  </div>
                  <div>
                    <label for="state" class="block text-sm font-semibold text-gray-700 mb-2">
                      Estado *
                    </label>
                    <input
                      type="text"
                      id="state"
                      name="state"
                      required
                      class="input w-full"
                      placeholder="SP"
                      maxlength="2"
                    />
                  </div>
                  <div>
                    <label for="zip" class="block text-sm font-semibold text-gray-700 mb-2">
                      CEP *
                    </label>
                    <input
                      type="text"
                      id="zip"
                      name="zip"
                      required
                      class="input w-full"
                      placeholder="00000-000"
                    />
                  </div>
                </div>
              </div>

              <!-- Additional Notes -->
              <div class="card">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Observações</h2>
                <textarea
                  id="notes"
                  name="notes"
                  rows="4"
                  class="input w-full"
                  placeholder="Informações adicionais sobre seu pedido (opcional)"
                ></textarea>
              </div>
            </form>
          </div>

          <!-- Order Summary -->
          <div class="lg:col-span-1">
            <div class="card sticky top-24">
              <h2 class="text-xl font-bold text-gray-900 mb-4">Resumo do Pedido</h2>

              <div id="cart-summary" class="space-y-4 mb-6">
                <!-- Cart items will be inserted here -->
              </div>

              <div class="border-t pt-4 space-y-2">
                <div class="flex items-center justify-between text-lg font-bold">
                  <span>Total:</span>
                  <span id="total-price" class="text-primary-600">R$ 0,00</span>
                </div>
              </div>

              <button
                type="submit"
                form="checkout-form"
                id="submit-order"
                class="btn bg-green-500 hover:bg-green-600 text-white w-full mt-6 text-lg py-3 flex items-center justify-center gap-2"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Enviar Pedido via WhatsApp
              </button>

              <p class="text-xs text-gray-500 text-center mt-4">
                Ao finalizar, você será redirecionado para o WhatsApp com os detalhes do seu pedido
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Checkout Script -->
  <script>
    import { formatPrice } from '../lib/utils';
    import type { CartItem } from '../types';

    // Load cart from localStorage
    const loadCart = (): CartItem[] => {
      const savedCart = localStorage.getItem('bm-cart');
      if (savedCart) {
        try {
          return JSON.parse(savedCart);
        } catch (e) {
          console.error('Error loading cart:', e);
        }
      }
      return [];
    };

    const cart = loadCart();

    // Redirect if cart is empty
    if (cart.length === 0) {
      window.location.href = '/produtos';
    }

    // Display cart summary
    const cartSummary = document.getElementById('cart-summary');
    const totalPrice = document.getElementById('total-price');

    if (cartSummary && totalPrice) {
      let total = 0;

      cart.forEach((item) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'flex justify-between text-sm';

        const itemPrice = item.price || 0;
        const itemTotal = itemPrice * item.quantity;
        total += itemTotal;

        itemDiv.innerHTML = `
          <div class="flex-1">
            <p class="font-semibold text-gray-900">${item.name}</p>
            <p class="text-gray-600">Qtd: ${item.quantity}</p>
          </div>
          <div class="text-right">
            <p class="font-bold text-primary-600">${formatPrice(itemTotal)}</p>
          </div>
        `;

        cartSummary.appendChild(itemDiv);
      });

      totalPrice.textContent = formatPrice(total);
    }

    // Handle form submission
    const form = document.getElementById('checkout-form') as HTMLFormElement;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const phone = formData.get('phone') as string;
      const address = formData.get('address') as string;
      const city = formData.get('city') as string;
      const state = formData.get('state') as string;
      const zip = formData.get('zip') as string;
      const notes = formData.get('notes') as string;

      // Build WhatsApp message
      let message = `🛒 *Novo Pedido*\n\n`;
      message += `👤 *Cliente:* ${name}\n`;
      message += `📧 *E-mail:* ${email}\n`;
      message += `📱 *Telefone:* ${phone}\n\n`;
      message += `📍 *Endereço de Entrega:*\n`;
      message += `${address}\n`;
      message += `${city} - ${state}\n`;
      message += `CEP: ${zip}\n\n`;
      message += `📦 *Itens do Pedido:*\n\n`;

      let total = 0;
      cart.forEach((item, index) => {
        const itemPrice = item.price || 0;
        const itemTotal = itemPrice * item.quantity;
        total += itemTotal;

        message += `${index + 1}. *${item.name}*\n`;
        if (item.price) {
          message += `   ${formatPrice(item.price)} x ${item.quantity} = ${formatPrice(itemTotal)}\n`;
        } else {
          message += `   Qtd: ${item.quantity} (consultar preço)\n`;
        }
        message += `\n`;
      });

      message += `💰 *Total:* ${formatPrice(total)}\n`;

      if (notes) {
        message += `\n📝 *Observações:*\n${notes}`;
      }

      // Encode message and redirect to WhatsApp
      const whatsappUrl = `https://wa.me/5519971477055?text=${encodeURIComponent(message)}`;

      // Clear cart
      localStorage.removeItem('bm-cart');

      // Redirect to WhatsApp
      window.location.href = whatsappUrl;
    });

    // Format phone input
    const phoneInput = document.getElementById('phone') as HTMLInputElement;
    phoneInput?.addEventListener('input', (e) => {
      let value = (e.target as HTMLInputElement).value.replace(/\D/g, '');

      if (value.length > 11) value = value.slice(0, 11);

      if (value.length > 6) {
        value = `(${value.slice(0, 2)}) ${value.slice(2, 7)}-${value.slice(7)}`;
      } else if (value.length > 2) {
        value = `(${value.slice(0, 2)}) ${value.slice(2)}`;
      }

      (e.target as HTMLInputElement).value = value;
    });

    // Format ZIP input
    const zipInput = document.getElementById('zip') as HTMLInputElement;
    zipInput?.addEventListener('input', (e) => {
      let value = (e.target as HTMLInputElement).value.replace(/\D/g, '');

      if (value.length > 8) value = value.slice(0, 8);

      if (value.length > 5) {
        value = `${value.slice(0, 5)}-${value.slice(5)}`;
      }

      (e.target as HTMLInputElement).value = value;
    });
  </script>

  <Footer slot="footer" client:load />
</BaseLayout>
